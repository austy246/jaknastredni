# data: syrová stažená data v data/raw/ se verzují v repu (rozhodnutí viz
# README.md, sekce Rozhodnutí o vývoji a ukládání dat), ale výsledná databáze
# ne — je 100% reprodukovatelná z data/raw/ skriptem jaknastredni.build_db,
# takže nemá smysl ji držet v gitu (binární soubor, roste s každou změnou).
*.db
*.db-journal
*.db-wal
*.db-shm

# python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
dist/
build/

# harness-managed scratch space (subagent git worktrees, local tool state)
.claude/

# Data pro webový prototyp jsou odvozená z databáze (viz jaknastredni/export_web.py),
# generují se jedním příkazem a mají stovky kB minifikovaného JSONu na jednom řádku
# — do gitu nepatří ze stejného důvodu jako *.db.
web/data.js
